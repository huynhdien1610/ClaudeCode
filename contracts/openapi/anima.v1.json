  "components": {
    "schemas": {
      "ClientSeedRequest": {
        "required": [
          "clientSeed"
        ],
        "type": "object",
        "properties": {
          "clientSeed": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ConvertRequest": {
        "required": [
          "direction",
          "amount"
        ],
        "type": "object",
        "properties": {
          "direction": {
            "type": [
              "null",
              "string"
            ]
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "ForgeRequest": {
        "required": [
          "cardInstanceIds",
          "feeCurrency"
        ],
        "type": "object",
        "properties": {
          "cardInstanceIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "feeCurrency": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LocaleRequest": {
        "required": [
          "locale"
        ],
        "type": "object",
        "properties": {
          "locale": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OtpVerifyRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PhoneRequest": {
        "required": [
          "phone"
        ],
        "type": "object",
        "properties": {
          "phone": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PurchaseRequest": {
        "required": [
          "currency"
        ],
        "type": "object",
        "properties": {
          "currency": {
            "type": [
              "null",
              "string"
            ]
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 1
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password",
          "birthDate",
          "country",
          "locale",
          "timezone"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "birthDate": {
            "type": [
              "null",
              "string"
            ]
          },
          "country": {
            "type": [
              "null",
              "string"
            ]
          },
          "locale": {
            "type": [
              "null",
              "string"
            ]
          },
          "timezone": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RotateRequest": {
        "required": [
          "clientSeed"
        ],
        "type": "object",
        "properties": {
          "clientSeed": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TopUpRequest": {
        "required": [
          "gem"
        ],
        "type": "object",
        "properties": {
          "gem": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "VerifyRequest": {
        "required": [
          "serverSeed",
          "clientSeed",
          "nonce",
          "slots"
        ],
        "type": "object",
        "properties": {
          "serverSeed": {
            "type": [
              "null",
              "string"
            ]
          },
          "clientSeed": {
            "type": [
              "null",
              "string"
            ]
          },
          "nonce": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "slots": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
